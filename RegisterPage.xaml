<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CodeTamagotchi.RegisterPage" Background="{StaticResource Bg}" Title="Регистрация">
  <VerticalStackLayout VerticalOptions="Center" Padding="28" Spacing="14">
    <Label Text="Давай познакомимся!" Style="{StaticResource Title}"/>
    <Border Style="{StaticResource CardBox}"><VerticalStackLayout Spacing="8">
      <Entry x:Name="Name" Placeholder="ФИО полностью"/>
      <Entry x:Name="Email" Placeholder="email" Keyboard="Email"/>
      <Entry x:Name="Pass" Placeholder="пароль (от 6 символов)" IsPassword="True"/>
      <Entry x:Name="PetName" Placeholder="имя хамелеона"/>
      <Label x:Name="Err" TextColor="#FB7185" IsVisible="False"/>
    </VerticalStackLayout></Border>
    <Button Text="Создать аккаунт" Style="{StaticResource Neon}" Clicked="OnRegister"/>
  </VerticalStackLayout>
</ContentPage>
